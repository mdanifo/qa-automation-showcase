{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim list",
  "description": "GET /api/claims: the claims the caller may see.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "claim.schema.json" }
    }
  }
}
